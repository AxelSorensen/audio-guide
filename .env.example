# Environment variables for Nuxt
# Get a Google Maps API Key with Maps JavaScript API and Places API enabled
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Get an OpenAI API Key
NUXT_OPENAI_API_KEY="your_openai_api_key_here"

# Get a Tavily API Key (https://tavily.com) — used by /api/generate-guide
# to search for background info on nearby places before generating narration
NUXT_TAVILY_API_KEY="your_tavily_api_key_here"
